# syntax=docker/dockerfile:1.7
FROM debian:bookworm-slim@sha256:88200866dfff7ea7f5cbcb6ec7c8a701889efe6fe859fe64d6990e4b07ea4171

ARG SQUID_VERSION=5.7-2+deb12u6

RUN apt-get update \
    && apt-get install --yes --no-install-recommends "squid=${SQUID_VERSION}" \
    && rm -rf /var/lib/apt/lists/* \
    && install -d -o proxy -g proxy -m 0700 /run/squid /var/log/squid

COPY proxy/squid.conf /etc/squid/squid.conf
COPY proxy/squid-routed.conf /etc/squid/squid-routed.conf

RUN squid -z -f /etc/squid/squid.conf \
    && chown -R proxy:proxy /var/spool/squid \
    && chmod 0444 /etc/squid/squid.conf /etc/squid/squid-routed.conf \
    && install -d -m 0755 /etc/squid/upstream.d \
    && echo '# vpn mode: no upstream peer' > /etc/squid/upstream.d/upstream.conf \
    && chmod 0444 /etc/squid/upstream.d/upstream.conf

USER proxy

STOPSIGNAL SIGTERM
ENTRYPOINT ["squid", "-N", "-f", "/etc/squid/squid.conf"]
